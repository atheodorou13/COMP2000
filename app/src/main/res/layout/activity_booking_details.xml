<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BookingDetailsActivity">

    <Button
        android:id="@+id/btnmybookings2"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:backgroundTint="#757575"
        android:text="My Bookings"
        android:textColor="#FFFFFF"
        tools:layout_editor_absoluteX="105dp"
        tools:layout_editor_absoluteY="441dp" />

    <Button
        android:id="@+id/btnReturntoHome4"
        android:layout_width="176dp"
        android:layout_height="49dp"
        android:backgroundTint="#757575"
        android:text="Return to Home"
        tools:layout_editor_absoluteX="121dp"
        tools:layout_editor_absoluteY="561dp" />

    <Button
        android:id="@+id/btnBack5"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:backgroundTint="#757575"
        android:text="Back"
        tools:layout_editor_absoluteX="105dp"
        tools:layout_editor_absoluteY="503dp" />

    <TextView
        android:id="@+id/txtBookingDetailsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Booking Details"
        android:textAllCaps="false"
        android:textColor="#031DB4"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutBooking1"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="#FBE1E5"
        android:orientation="vertical"
        android:padding="16dp"
        tools:layout_editor_absoluteX="55dp"
        tools:layout_editor_absoluteY="90dp">

        <ImageView
            android:id="@+id/imageView30"
            android:layout_width="43dp"
            android:layout_height="31dp"
            android:baselineAlignBottom="true"
            app:srcCompat="@drawable/room" />

        <TextView
            android:id="@+id/txtBookingRoom2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meeting Room 1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtBookingDate2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="26 Oct 2026"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtBookingTime2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10:00 - 11:00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtBookingStatus2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Pending"
            android:textColor="#C58B00"
            android:textSize="16sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnCancelBooking1"
        android:layout_width="231dp"
        android:layout_height="54dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="#E53935"
        android:text="Cancel Booking"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutBooking1" />

    <ImageView
        android:id="@+id/imageView31"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/mybookings"
        tools:layout_editor_absoluteX="121dp"
        tools:layout_editor_absoluteY="450dp" />

    <ImageView
        android:id="@+id/imageView32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="#000000"
        app:srcCompat="@drawable/outline_arrow_back_ios_24"
        tools:layout_editor_absoluteX="121dp"
        tools:layout_editor_absoluteY="516dp" />

    <ImageView
        android:id="@+id/imageView34"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/outline_home_24"
        tools:layout_editor_absoluteX="129dp"
        tools:layout_editor_absoluteY="576dp" />

</androidx.constraintlayout.widget.ConstraintLayout>