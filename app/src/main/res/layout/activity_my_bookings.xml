<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MyBookingsActivity">

    <Button
        android:id="@+id/btnReturntoHome3"
        android:layout_width="163dp"
        android:layout_height="46dp"
        android:backgroundTint="#757575"
        android:text="Return to Home"
        tools:layout_editor_absoluteX="149dp"
        tools:layout_editor_absoluteY="642dp" />

    <Button
        android:id="@+id/btnBack4"
        android:layout_width="123dp"
        android:layout_height="44dp"
        android:backgroundTint="#757575"
        android:text="Back"
        tools:layout_editor_absoluteX="165dp"
        tools:layout_editor_absoluteY="586dp" />

    <LinearLayout
        android:id="@+id/layoutBooking1"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="216dp"
        android:background="#FBE1E5"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.63"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnPast">

        <TextView
            android:id="@+id/txtBookingRoom2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seminar Room 1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtBookingDate2"
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:text="28 Oct 2026"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtBookingTime2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15:00 - 16:00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtBookingStatus2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Approved"
            android:textColor="#228B22"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnViewBooking1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00B8C4"
            android:text="View Details" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtMyBookingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="My Bookings"
        android:textAllCaps="false"
        android:textColor="#031DB4"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutBooking1"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FBE1E5"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.63"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnPast">

        <TextView
            android:id="@+id/txtBookingRoom2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meeting Room 1"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtBookingDate2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="26 Oct 2026"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtBookingTime2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10:00 - 11:00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtBookingStatus2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Pending"
            android:textColor="#C58B00"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnViewBooking1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00B8C4"
            android:text="View Details" />

    </LinearLayout>

    <Button
        android:id="@+id/btnPast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="68dp"
        android:backgroundTint="#757575"
        android:text="Past"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="106dp" />

    <Button
        android:id="@+id/btnUpcoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="76dp"
        android:backgroundTint="#00B8C4"
        android:text="Upcoming"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="106dp" />

</androidx.constraintlayout.widget.ConstraintLayout>