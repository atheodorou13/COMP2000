<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AvailableRoomsActivity">

    <TextView
        android:id="@+id/txtAvailableRooms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Available Rooms"
        android:textColor="#031DB4"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtAvailabilityInfo"
        android:layout_width="369dp"
        android:layout_height="98dp"
        android:layout_marginTop="24dp"
        android:text="Available rooms for your selected date and time"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtAvailableRooms" />

    <Button
        android:id="@+id/btnMeetingRoom1"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginStart="86dp"
        android:layout_marginTop="218dp"
        android:layout_marginEnd="85dp"
        android:backgroundTint="#00B8C4"
        android:text="Meeting Room 1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnMeetingRoom2"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginStart="85dp"
        android:layout_marginTop="290dp"
        android:layout_marginEnd="86dp"
        android:backgroundTint="#00B8C4"
        android:text="Meeting Room 2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnSeminarRoom1"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_marginStart="85dp"
        android:layout_marginTop="362dp"
        android:layout_marginEnd="86dp"
        android:backgroundTint="#00B8C4"
        android:text="Seminar Room 1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
